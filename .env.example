# ==============================================================================
# CONFIGURACIÓN DEL AGENTE DE MONITOREO - VISA WORK AND HOLIDAY 462 (AUSTRALIA)
# ==============================================================================

# --- CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP) ---
# Se enviará una alerta importante por correo electrónico cuando la visa esté ABIERTA
EMAIL_ENABLED=true
EMAIL_TO=maverick6576@gmail.com
EMAIL_FROM=tu_correo@gmail.com
# Para Gmail, usa smtp.gmail.com (puerto 587 con TLS) y una Contraseña de Aplicación (App Password)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=tu_correo@gmail.com
EMAIL_SMTP_PASSWORD=tu_app_password_de_gmail

# --- CONFIGURACIÓN DE TELEGRAM BOT API ---
# 1. Crea un bot hablando con @BotFather en Telegram y obtén el Token.
# 2. Obtén tu Chat ID hablando con @userinfobot o @get_id_bot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# --- CONFIGURACIÓN DE DISCORD WEBHOOK ---
# En Discord: Configuración de canal -> Integraciones -> Crear Webhook -> Copiar URL
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXX/YYYYYY

# --- PARÁMETROS DEL SISTEMA ---
# Frecuencia en minutos para el modo demonio (--daemon) y Programador de Tareas
CHECK_INTERVAL_MINUTES=15

# Si es true, enviará notificación en la primera ejecución independientemente del estado anterior
NOTIFY_ON_FIRST_RUN=false

# Timeout para las peticiones HTTP (en segundos)
REQUEST_TIMEOUT_SECONDS=30

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
